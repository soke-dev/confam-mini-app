# Copy to .env and fill in. Never commit .env.
#
# This file doubles as the deploy checklist: every variable below that is not
# marked optional has to exist in Railway before the service is useful.

# ── Database ────────────────────────────────────────────────────────────────
# Railway: Postgres service → Variables.
#   DATABASE_PUBLIC_URL  while the API runs on your laptop
#   DATABASE_URL         once the API is deployed beside it, so traffic stays
#                        on the private network and costs no egress
DATABASE_URL=

# ── Server ──────────────────────────────────────────────────────────────────
# Railway injects PORT. Setting it there yourself will break the healthcheck.
PORT=8080

# ── Evidence storage ────────────────────────────────────────────────────────
# disk    a folder in the container. Development only — Railway wipes the
#         container filesystem on every deploy, so evidence would vanish
#         partway through a dispute.
# volume  the same folder on a Railway Volume. Survives deploys. Production.
# object  R2/S3. Not implemented yet.
#
# For Railway: add a Volume to the service, mount it at /data, and set
# STORAGE_DIR to the same path. A volume pins the service to one replica.
STORAGE_DRIVER=disk
STORAGE_DIR=.uploads

# ── Auth ────────────────────────────────────────────────────────────────────
# Without these every request is unauthenticated, which is fine locally and
# catastrophic anywhere else.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ── Review desk ─────────────────────────────────────────────────────────────
# bcrypt hash, not the password. Unset and /admin is unreachable.
ADMIN_PASSWORD_HASH=

# ── Vision ──────────────────────────────────────────────────────────────────
# Optional. Without it the relevance check reports itself as skipped and every
# other check still runs.
OPENAI_API_KEY=
VISION_MODEL=gpt-5

# ── Agents ──────────────────────────────────────────────────────────────────
# Whether this server answers to programs as well as to people.
#
# Off by default, and off means gone: /agent returns 404, API keys cannot be
# minted or used, and nothing in the app behaves differently. One switch for
# the whole surface, so turning it off is a decision somebody can make later
# without knowing what was built.
AGENTS_ENABLED=false

# What an agent pays when an existing verified answer is reused rather than
# somebody being sent. In kobo.
AGENT_CACHED_FEE_KOBO=5000

# A hard ceiling above the model's judgment. However good an old answer looks,
# past this it is never handed back as the current state of a place.
AGENT_MAX_AGE_MINUTES=1440

# The public /demo page posts real jobs, so it spends from one account against
# a ceiling. Unset AGENT_DEMO_KEY and the page still shows the agent deciding
# but will not send anybody — which is the right default for a server nobody
# has given a budget to.
AGENT_DEMO_KEY=
AGENT_DEMO_BUDGET_KOBO=500000
# Capped at 15000 (N150) in code and cannot be raised from here. The demo is
# spent by anyone who opens a public page, so the only safe amount is the
# smallest that still buys a real trip. Lowering it works; lifting it does not.
AGENT_DEMO_BOUNTY_KOBO=15000

# ── Chain ───────────────────────────────────────────────────────────────────
# Base mainnet. The escrow holds real USDC.
ESCROW_ADDRESS=
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Two RPCs on purpose. Alchemy reports nonces correctly but caps eth_getLogs at
# 10 blocks on the free tier, which breaks deposit sync — so log scanning goes
# somewhere with a wider window.
BASE_RPC_URL=
BASE_LOGS_RPC_URL=

# The account that pays gas so users never need ETH. Relays EIP-3009
# withdrawals; never custodies USDC. Needs a small ETH balance on Base.
# Server-side only: never prefix this EXPO_PUBLIC_.
# Rules on disputed jobs. resolve() is onlyArbiter and neither the relayer nor
# the agent wallet is it, so this is its own key. Needs a little ETH on Base:
# it sends the transaction itself rather than forwarding a signature.
#
# Unset and the review desk still records a decision, and says plainly that the
# escrow was not moved.
ARBITER_PRIVATE_KEY=

GAS_WALLET_PRIVATE_KEY=
MIN_GAS_WALLET_ETH=0.0002

# Optional. Falls back to a bundled rate when unset.
FX_RATE_URL=

# ── Check thresholds ────────────────────────────────────────────────────────
# Starting values, not measured ones. `npm run checks:try` shows how they
# behave against real files.

# Laplacian variance on a 640px greyscale copy. Higher is sharper.
SHARPNESS_RETAKE_BELOW=40
SHARPNESS_WARN_BELOW=90

# Mean luma, 0-255.
EXPOSURE_DARK_RETAKE_BELOW=22
EXPOSURE_DARK_WARN_BELOW=45
EXPOSURE_BRIGHT_WARN_ABOVE=225
EXPOSURE_CLIPPED_WARN_ABOVE=0.45

# Distance from the pin. Advisory only — never rejects a submission.
GEO_NEAR_METRES=150
GEO_FAR_METRES=600

# Media limits.
MAX_UPLOAD_BYTES=41943040
MAX_PHOTOS=5
MAX_VIDEO_SECONDS=30
MIN_VIDEO_SECONDS=2
VIDEO_FRAMES_SAMPLED=3

# Retakes allowed before the job returns to the pool.
MAX_SUBMISSION_ATTEMPTS=3

# Signs the web app wallet sessions (any long random string).
# Unset, a key is invented at boot: every restart signs everybody out and a
# second instance rejects the first one tokens.
MINI_SESSION_SECRET=

# Polygon, for the mini app balance (USDT). Defaults work without these.
# polygon-rpc.com now returns 401; publicnode is the default.
POLYGON_RPC_URL=
POLYGON_USDT_ADDRESS=

# AskEscrow on Polygon (the proxy). Empty until deployed; funding on Polygon
# is simply unavailable while it is unset.
POLYGON_ESCROW_ADDRESS=

# How far from a place somebody may be and still take the job, in metres.
# 15000 by default. Ikeja to Surulere is about 12.5km, so anything at or above
# that stops separating neighbourhoods; narrow it here rather than in code.
ACCEPT_RADIUS_METRES=

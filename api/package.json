{
  "name": "ask-nearby-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/migrate.js && node dist/server.js",
    "build": "node scripts/sync-legal.mjs && tsc -p tsconfig.json && node scripts/check-demo.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/migrate.ts",
    "checks:try": "tsx src/checks/try.ts",
    "check:signin": "node scripts/check-signin.mjs",
    "check:permit": "node scripts/check-permit.mjs",
    "images": "node scripts/inline-images.mjs"
  },
  "dependencies": {
    "@privy-io/node": "^0.29.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "multer": "^2.2.0",
    "openai": "^6.49.0",
    "pg": "^8.13.1",
    "sharp": "^0.33.5",
    "viem": "^2.55.19",
    "ws": "^8.21.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ffprobe-static": "^2.0.3",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2"
  }
}
